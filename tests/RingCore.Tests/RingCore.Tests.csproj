    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>RingCore 单元测试。覆盖率硬门槛 > 90%。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RingCore\RingCore.csproj" />
